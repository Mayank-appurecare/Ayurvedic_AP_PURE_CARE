    "@react-navigation/native-stack": "^7.18.10",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.16",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-linear-gradient": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.10",
    "detox": "^20.51.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "newman": "^6.2.2",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:api": "newman run postman/collection.postman.json -e postman/environment.postman.json",
    "test:e2e:build": "detox build -c android.emu.debug",
    "test:e2e": "detox test -c android.emu.debug",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "allowScripts": {
    "@sentry/cli@2.58.4": true,
    "detox@20.51.4": true,
    "unrs-resolver@1.12.2": true,
    "dtrace-provider@0.8.8": true
  }
