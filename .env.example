# Copy this file to .env and fill in real values. .env is gitignored.

# Backend API base URL (see src/services/auth/apiAuthService.ts).
# The ngrok tunnel URL changes between dev sessions — update it here instead of editing code.
EXPO_PUBLIC_API_BASE_URL=https://bartender-sloppy-sandstone.ngrok-free.dev

# Sentry DSN (from your Sentry project settings). Leave blank to disable crash reporting.
EXPO_PUBLIC_SENTRY_DSN=
